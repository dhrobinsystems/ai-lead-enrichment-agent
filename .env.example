# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
# 3000 avoids clashing with n8n, which uses 5678 by default.
PORT=3000
NODE_ENV=production

# Shared secret callers must send as the "x-webhook-secret" header
# (or "Authorization: Bearer <secret>"). Minimum 16 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=change_me_to_a_long_random_string

# ---------------------------------------------------------------
# Safety
# ---------------------------------------------------------------
# Dry-run stays ON unless this is exactly "false". When ON, HubSpot payloads
# are logged and nothing is written. Set to false only after testing against
# a HubSpot sandbox or test portal.
AGENT_DRY_RUN=true

# ---------------------------------------------------------------
# LLM provider: "openai" or "anthropic"
# ---------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Plain-English description of your Ideal Customer Profile, used for scoring.
ICP_DESCRIPTION="B2B SaaS or tech-enabled services companies with 20-500 employees and $2M-$100M annual revenue that run a sales team on HubSpot or Salesforce."

# ---------------------------------------------------------------
# Firmographic data (headcount, revenue, industry, tech stack)
# ---------------------------------------------------------------
# Optional, but without it the LLM scores on the domain alone and
# headcount/revenue are left empty rather than guessed.
APOLLO_API_KEY=

# ---------------------------------------------------------------
# HubSpot
# ---------------------------------------------------------------
# Private app access token. Scopes: crm.objects.companies.read,
# crm.objects.companies.write, crm.schemas.companies.write (setup script only).
HUBSPOT_ACCESS_TOKEN=
